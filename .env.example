# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jay_aesthetics?schema=public

# Auth — use a long random value in production (32+ chars)
JWT_SECRET=change-this-to-a-long-random-secret

# Production email OTP/password reset/admin 2FA (Resend)
RESEND_API_KEY=
EMAIL_FROM=Jay Aesthetics <no-reply@yourdomain.com>

# Production admin bootstrap (used by prisma seed)
ADMIN_EMAIL=admin@jayaesthetics.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# Persistent media directory. Local default is apps/api/uploads.
# On Railway/Render mount a persistent volume and set this to its mount path.
UPLOAD_DIR=

# Optional direct-call number shown only to active clients during configured call hours
COACH_PHONE_NUMBER=

# Razorpay — intentionally left for later
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local development only. NEVER true in production.
DEV_MOCK_PAYMENTS=true
